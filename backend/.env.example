# SentinelOps Environment Variables Template
# Copy this file to .env before running the application

# Security (Required)
SECRET_KEY=generate_a_very_long_secure_random_string_here

# Database
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/sentinelsops

# Redis
REDIS_URL=redis://localhost:6379/0

# Comma-separated deployment origins and hostnames
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1
SENSOR_STALE_AFTER_SECONDS=180
NETWORK_CONNECTIVITY_TARGET=1.1.1.1
NETWORK_RETENTION_DAYS=90
